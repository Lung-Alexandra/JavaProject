FROM eclipse-temurin:21-jdk-jammy AS build

WORKDIR /app

COPY .mvn/ .mvn/
COPY mvnw pom.xml ./

RUN chmod +x mvnw
RUN ./mvnw --batch-mode --no-transfer-progress dependency:go-offline

COPY src/ src/

RUN ./mvnw --batch-mode --no-transfer-progress clean package -DskipTests


FROM eclipse-temurin:21-jre-jammy

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

WORKDIR /app

COPY --from=build /app/target/*.jar /app/app.jar

# Deployment-ul eșuează la build dacă imaginea finală nu conține Java.
RUN /opt/java/openjdk/bin/java -version

EXPOSE 80

CMD ["/opt/java/openjdk/bin/java", "-jar", "/app/app.jar"]
